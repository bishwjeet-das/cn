#include <stdio.h>
#include <string.h>

#define MAX 10

struct Car {
    char plate[20];
    int moveCount;
};

struct Car garage[MAX];
int top = -1;

struct Car temp[MAX];
int tempTop = -1;

int isFull() {
    return top == MAX - 1;
}

int isEmpty() {
    return top == -1;
}

void push(struct Car c) {
    garage[++top] = c;
}

struct Car pop() {
    return garage[top--];
}

void tempPush(struct Car c) {
    temp[++tempTop] = c;
}

struct Car tempPop() {
    return temp[tempTop--];
}

void displayGarage() {

    printf("Current cars in garage: ");

    if (isEmpty()) {
        printf("Empty");
    } 
    else {

        for (int i = 0; i <= top; i++) {
            printf("%s ", garage[i].plate);
        }
    }

    printf("\n");
}

int main() {

    char type;
    char plate[20];

    printf("Enter operations (A/D plate_number).\n");
    printf("Enter X to stop.\n\n");

    while (1) {

        scanf(" %c", &type);

        if(type == 'X')
            break;

        scanf("%s", plate);

        if (type == 'A') {

            printf("Car %s arrives. ", plate);

            if (isFull()) {

                printf("Garage is full. Car leaves.\n");

            } 
            else {

                struct Car newCar;

                strcpy(newCar.plate, plate);
                newCar.moveCount = 0;

                push(newCar);

                printf("Car parked.\n");
            }
        }

        else if (type == 'D') {

            printf("Car %s departs. ", plate);

            if (isEmpty()) {

                printf("Garage is empty.\n");

            } 
            else {

                int found = 0;

                while (!isEmpty()) {

                    struct Car c = pop();

                    if (strcmp(c.plate, plate) == 0) {

                        printf("Moved %d times.\n", c.moveCount);

                        found = 1;

                        break;
                    } 
                    else {

                        c.moveCount++;

                        tempPush(c);
                    }
                }

                if (!found) {
                    printf("Car not found.\n");
                }

                while (tempTop != -1) {

                    push(tempPop());
                }
            }
        }

        else {

            printf("Invalid operation.\n");
        }

        displayGarage();

        printf("-----------------------------\n\n");
    }

    return 0;
}

