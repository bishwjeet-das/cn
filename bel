#include <stdio.h>
#include <limits.h>

#define MAX 100
#define INF 99999


struct Edge {
    int u, v, w;
};


void printTable(int dist[][MAX], int V, int step) {
    printf("\nStep %d:\n", step);
    for (int i = 0; i < V; i++) {
        if (dist[step][i] == INF)
            printf("INF ");
        else
            printf("%3d ", dist[step][i]);
    }
    printf("\n");
}


void printPath(int parent[], int j) {
    if (parent[j] == -1)
        return;
    printPath(parent, parent[j]);
    printf("->%d", j + 1);
}


void BellmanFord(struct Edge edges[], int V, int E, int src) {
    int dist[MAX], parent[MAX];
    int table[MAX][MAX];

    
    for (int i = 0; i < V; i++) {
        dist[i] = INF;
        parent[i] = -1;
    }
    dist[src] = 0;

    
    for (int i = 0; i < V; i++)
        table[0][i] = dist[i];

    
    for (int i = 1; i < V; i++) {
        for (int j = 0; j < V; j++)
            table[i][j] = table[i - 1][j];

        for (int j = 0; j < E; j++) {
            int u = edges[j].u;
            int v = edges[j].v;
            int w = edges[j].w;

            if (table[i - 1][u] != INF && table[i - 1][u] + w < table[i][v]) {
                table[i][v] = table[i - 1][u] + w;
                parent[v] = u;
            }
        }
    }

    
    printf("\nDistance Table:\n");
    for (int i = 0; i < V; i++) {
        printf("k=%d: ", i);
        for (int j = 0; j < V; j++) {
            if (table[i][j] == INF)
                printf("INF ");
            else
                printf("%3d ", table[i][j]);
        }
        printf("\n");
    }

    
    for (int i = 0; i < E; i++) {
        int u = edges[i].u;
        int v = edges[i].v;
        int w = edges[i].w;

        if (dist[u] != INF && dist[u] + w < dist[v]) {
            printf("\nGraph contains negative weight cycle!\n");
            return;
        }
    }

    
    printf("\nFinal Shortest Distances:\n");
    for (int i = 0; i < V; i++) {
        printf("Vertex %d = %d\n", i + 1, table[V - 1][i]);
    }

    
    printf("\nPaths:\n");
    for (int i = 0; i < V; i++) {
        if (i == src) continue;
        printf("%d", src + 1);
        printPath(parent, i);
        printf(" : %d\n", table[V - 1][i]);
    }
}


int main() {
    int V, E;

    printf("Enter number of vertices: ");
    scanf("%d", &V);

    printf("Enter number of edges: ");
    scanf("%d", &E);

    struct Edge edges[E];

    printf("Enter edges (source destination weight) [1-based index]:\n");
    for (int i = 0; i < E; i++) {
        scanf("%d %d %d", &edges[i].u, &edges[i].v, &edges[i].w);
        edges[i].u--; // convert to 0-based
        edges[i].v--;
    }

    int src;
    printf("Enter source vertex: ");
    scanf("%d", &src);
    src--;

    BellmanFord(edges, V, E, src);

    return 0;
}
