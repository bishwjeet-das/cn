import java.util.Scanner;
import java.util.Locale;

class MaxThread extends Thread {

    private int[] numbers;
    private int maximum;

    public MaxThread() {

    }

    public MaxThread(int[] numbers) {
        this.numbers = numbers;
    }

    public int getMaximum() {
        return maximum;
    }

    public void setNumbers(int[] numbers) {
        this.numbers = numbers;
    }

    @Override
    public void run() {

        if (numbers == null || numbers.length == 0) {

            System.out.println("Array is Empty");

            return;
        }

        maximum = numbers[0];

        for (int i = 1; i < numbers.length; i++) {

            if (numbers[i] > maximum) {

                maximum = numbers[i];
            }
        }

        System.out.println("Maximum Element : " + maximum);
    }
}

class AverageThread extends Thread {

    private int[] numbers;
    private double average;

    public AverageThread() {

    }

    public AverageThread(int[] numbers) {
        this.numbers = numbers;
    }

    public double getAverage() {
        return average;
    }

    public void setNumbers(int[] numbers) {
        this.numbers = numbers;
    }

    @Override
    public void run() {

        if (numbers == null || numbers.length == 0) {

            System.out.println("Array is Empty");

            return;
        }

        int sum = 0;

        for (int i = 0; i < numbers.length; i++) {

            sum = sum + numbers[i];
        }

        average = (double) sum / numbers.length;

        System.out.printf(Locale.US, "Average : %.4f\n", average);
    }
}

public class Driver {

    public static void main(String[] args) {

        Scanner scannerObject = new Scanner(System.in);

        System.out.print("Enter Number of Elements : ");

        int size = scannerObject.nextInt();

        if (size <= 0) {

            System.out.println("Invalid Array Size");

            return;
        }

        int[] numbers = new int[size];

        System.out.println("Enter Array Elements : ");

        for (int i = 0; i < size; i++) {

            numbers[i] = scannerObject.nextInt();
        }

        MaxThread maxObject = new MaxThread(numbers);

        AverageThread averageObject = new AverageThread(numbers);

        maxObject.start();

        averageObject.start();

        try {

            maxObject.join();

            averageObject.join();

        } catch (InterruptedException e) {

            System.out.println("Main Thread Interrupted");
        }

        int maximum = maxObject.getMaximum();

        double average = averageObject.getAverage();

        double result = maximum / average;

        System.out.printf(Locale.US, "Result (Max / Average) : %.4f\n", result);

        scannerObject.close();
    }
}
