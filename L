#include <stdio.h>

#define MAX_USERS 100
#define MAX_TRANS 100

// Function to input data
void inputData(int n, int user_id[], int start_time[], int t[], int dur[][MAX_TRANS]) {
    for (int i = 0; i < n; i++) {
        printf("\nEnter data for User %d\n", i + 1);

        printf("Enter user ID: ");
        scanf("%d", &user_id[i]);

        printf("Enter starting time: ");
        scanf("%d", &start_time[i]);

        printf("Enter the number of transactions: ");
        scanf("%d", &t[i]);

        printf("Enter the durations of the transactions: ");
        for (int j = 0; j < t[i]; j++) {
            scanf("%d", &dur[i][j]);
        }
    }
}

// Function to simulate FCFS scheduling
void simulate(int n, int user_id[], int start_time[], int t[], int dur[][MAX_TRANS]) {
    int current_time = 0;
    int total_waiting_time = 0;
    int total_transactions = 0;

    for (int i = 0; i < n; i++) {

        for (int j = 0; j < t[i]; j++) {

            // Flowchart condition: CPU idle check
            if (current_time < start_time[i]) {
                current_time = start_time[i];
            }

            int start = current_time;
            int waiting = start - start_time[i];
            int end = start + dur[i][j];

            printf("User %d Transaction %d: Start time: %d End time: %d Waiting time: %d - %d = %d seconds\n",
                   user_id[i], j + 1, start, end, start, start_time[i], waiting);

            total_waiting_time += waiting;
            total_transactions++;

            current_time = end;
        }
    }

    float avg = (float)total_waiting_time / total_transactions;
    printf("Average waiting time: %.2f seconds\n", avg);
}

// Main function
int main() {
    int n;

    printf("Enter the number of users: ");
    scanf("%d", &n);

    int user_id[MAX_USERS], start_time[MAX_USERS], t[MAX_USERS];
    int dur[MAX_USERS][MAX_TRANS];

    // Input function
    inputData(n, user_id, start_time, t, dur);

    // Simulation function
    simulate(n, user_id, start_time, t, dur);

    return 0;
}
