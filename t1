#include <stdio.h>
#include <string.h>

#define MAX 100
#define NAME 50

struct Person
{
    char name[NAME];
    int num;
};

void eliminate(struct Person p[], int total, int count)
{
    int index = 0;

    printf("Elimination Order:\n");

    while(total > 1)
    {
        index = (index + count - 1) % total;

        printf("%s\n", p[index].name);

        count = p[index].num;

        for(int i = index; i < total - 1; i++)
        {
            p[i] = p[i + 1];
        }

        total--;

        if(index == total)
        {
            index = 0;
        }
    }

    printf("Last Person: %s\n", p[0].name);
}

int main()
{
    struct Person p[MAX];

    int n;
    int initial;

    scanf("%d", &n);

    for(int i = 0; i < n; i++)
    {
        scanf("%s %d", p[i].name, &p[i].num);
    }

    scanf("%d", &initial);

    eliminate(p, n, initial);

    return 0;
}
