import java.applet.Applet;
import java.awt.Color;
import java.awt.Graphics;

/*
<applet code="SmileyApplet" width="400" height="400">
</applet>
*/

public class SmileyApplet extends Applet {

    // Default Constructor
    public SmileyApplet() {
    }

    // Draw Smiley Face
    public void paint(Graphics g) {

        // Face
        g.setColor(Color.YELLOW);
        g.fillOval(100, 100, 200, 200);

        // Eyes
        g.setColor(Color.BLACK);
        g.fillOval(150, 150, 20, 20);
        g.fillOval(230, 150, 20, 20);

        // Smile
        g.drawArc(150, 180, 100, 50, 180, 180);

        // Nose
        g.drawLine(200, 170, 190, 210);
        g.drawLine(190, 210, 210, 210);
    }
}

